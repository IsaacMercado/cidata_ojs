{
	email {$ACME_EMAIL:admin@cidata.gob.ve}
	# Solo Let's Encrypt: ZeroSSL rechaza algunos dominios .gob.ve.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	admin off
}

{$SERVERNAME} {
	encode zstd gzip

	# Los recursos de OJS llevan ?v=, así que se pueden cachear.
	@coreAssets path /lib/* /js/*
	header @coreAssets Cache-Control "public, max-age=604800, immutable"

	# El tema y los archivos públicos pueden cambiar; una hora es prudente.
	@mutableAssets path /plugins/* /public/*
	header @mutableAssets Cache-Control "public, max-age=3600"

	reverse_proxy app:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
