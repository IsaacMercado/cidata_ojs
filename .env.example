# ============================================================
# REVEDACYT — configuración de producción
# Copia este archivo a .env y ajusta los valores.
# Las contraseñas vacías las genera install.sh; no ejecutes
# `docker compose up` directamente antes de instalarlo.
# ============================================================

# --- Dominio y TLS -----------------------------------------
SERVERNAME=revedacyt.cidata.gob.ve
ACME_EMAIL=soporte@cidata.gob.ve
TZ=America/Caracas

# --- OJS ---------------------------------------------------
OJS_VERSION=3_5_0-6
OJS_ADMIN_USER=admin
OJS_ADMIN_EMAIL=soporte@cidata.gob.ve
OJS_MAIL_METHOD=log

# --- Base de datos -----------------------------------------
# install.sh genera DB_PASSWORD y DB_ROOT_PASSWORD si están vacías.
DB_NAME=ojs
DB_USER=ojs
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Secretos de OJS ---------------------------------------
# install.sh los genera si están vacíos. No los cambies después
# sin respaldar la base de datos.
OJS_ADMIN_PASSWORD=
OJS_SALT=
OJS_API_KEY_SECRET=

# --- Respaldos ---------------------------------------------
# Déjalo vacío para guardar solo copias locales.
BACKUP_BUCKET=cidata-ojs-prod-backups-947567203188

# --- Correo saliente (opcional) ----------------------------
# Si SMTP_HOST está vacío, OJS no envía correo (método "log").
# La contraseña NO se escribe aquí: va en el archivo indicado
# por SMTP_PASSWORD_FILE, con permisos 0600.
SMTP_HOST=
SMTP_PORT=465
SMTP_AUTH=ssl
SMTP_USER=soporte@cidata.gob.ve
SMTP_FROM=soporte@cidata.gob.ve
SMTP_PASSWORD_FILE=secrets/smtp_password
